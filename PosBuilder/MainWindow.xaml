<Window x:Class="PosBuilder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PosBuilder"
        xmlns:views="clr-namespace:PosBuilder.Views"
        xmlns:controls="clr-namespace:PosBuilder.Views.Controls"
        Title="PosBuilder - Asistente de Configuración" Height="800" Width="1300"
        WindowStartupLocation="CenterScreen" Background="#0B1121"
        FontFamily="Segoe UI">
    <Window.Resources>
        
        <Style TargetType="Button" x:Key="NavButton">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#334155"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource TextPrimaryBrush}" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M 2,4 L 18,4 L 18,16 L 2,16 Z" Fill="#3B82F6" Width="20" Height="20" Stretch="Uniform" Margin="0,0,10,0"/>
                    <TextBlock Text="PosBuilder" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text=" · " FontSize="16" Foreground="#64748B" VerticalAlignment="Center" Margin="5,0"/>
                    <TextBlock Text="Asistente de Configuración" FontSize="14" Foreground="#94A3B8" VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0"/>
                    <TextBlock Text="v2.4.1" FontSize="12" Foreground="#94A3B8" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource TextPrimaryBrush}" BorderBrush="#1E293B" BorderThickness="0,0,1,0" Padding="15,20">
                <ItemsControl x:Name="StepList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="10,12" Margin="0,0,0,5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Color}" Value="#3B82F6">
                                                <Setter Property="Background" Value="#1E293B"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="24" Height="24" CornerRadius="8" Background="{Binding Color}" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Icon}" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Color}" Value="#3B82F6">
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Color}" Value="#10B981">
                                                            <Setter Property="Foreground" Value="#E2E8F0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            
            <!-- Main Content Area -->
            <Border Grid.Column="1" Padding="40,30,40,30">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{Binding CurrentStepSubTitle}" Foreground="#64748B" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Border Background="#1E3A8A" CornerRadius="8" Padding="10,4">
                            <TextBlock Text="{Binding CurrentStepCategory}" Foreground="#60A5FA" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    
                    <TextBlock Grid.Row="1" Text="{Binding CurrentStepTitle}" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,0,0,25"/>
                    
                    <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="30" VerticalAlignment="Top">
                        <Border.Effect>
                            <DropShadowEffect Color="#020617" BlurRadius="16" ShadowDepth="4" Opacity="0.06" Direction="270" />
                        </Border.Effect>
                        <ContentControl x:Name="StepContentControl" />
                    </Border>
                </Grid>
            </Border>
            
            <!-- Right Preview Pane -->
            <Border Grid.Column="2" Background="#0B1121" BorderBrush="#1E293B" BorderThickness="1,0,0,0" Padding="20">
                <StackPanel>
                    <TextBlock Text="VISTA PREVIA EN TIEMPO REAL" FontSize="12" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,15"/>
                    
                    <!-- Mobile Preview Mock -->
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="0" Margin="0,0,0,15" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Top Bar -->
                            <Border Grid.Row="0" Background="{Binding BrandingColor, TargetNullValue=#3B82F6}" Padding="15,10">
                                <Grid>
                                    <TextBlock Text="☐" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BrandingName, FallbackValue='MI POS', TargetNullValue='MI POS'}" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                    <TextBlock Text="•••" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            
                            <!-- Content -->
                            <StackPanel Grid.Row="1" Margin="15">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15" HorizontalAlignment="Center">
                                    <Border Background="#2563EB" CornerRadius="8" Padding="10,4" Margin="0,0,5,0">
                                        <TextBlock Text="Venta" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border Background="#F1F5F9" CornerRadius="8" Padding="10,4" Margin="0,0,5,0">
                                        <TextBlock Text="Caja" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border Background="#F1F5F9" CornerRadius="8" Padding="10,4">
                                        <TextBlock Text="Inventario" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                
                                <Grid Margin="0,0,0,15">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Border Grid.Row="0" Grid.Column="0" Background="#F1F5F9" CornerRadius="8" Height="60" Margin="0,0,10,10">
                                        <TextBlock Text="Café" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" FontSize="11"/>
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="1" Background="#F1F5F9" CornerRadius="8" Height="60" Margin="0,0,10,10">
                                        <TextBlock Text="Pan" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" FontSize="11"/>
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="2" Background="#F1F5F9" CornerRadius="8" Height="60" Margin="0,0,0,10">
                                        <TextBlock Text="Jugo" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" FontSize="11"/>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="0" Background="#F1F5F9" CornerRadius="8" Height="60" Margin="0,0,10,0">
                                        <TextBlock Text="Agua" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" FontSize="11"/>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="1" Background="#F1F5F9" CornerRadius="8" Height="60" Margin="0,0,10,0">
                                        <TextBlock Text="Snack" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" FontSize="11"/>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="2" Background="#F1F5F9" CornerRadius="8" Height="60">
                                        <TextBlock Text="Otro" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" FontSize="11"/>
                                    </Border>
                                </Grid>
                                
                                <Grid>
                                    <TextBlock Text="Total" FontWeight="Bold" Foreground="#334155" FontSize="14"/>
                                    <TextBlock Text="$0.00" FontWeight="Bold" Foreground="#2563EB" FontSize="14" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- Config Box -->
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Configuración" Foreground="#64748B" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Entorno" Foreground="#94A3B8" FontSize="12"/>
                                <Border HorizontalAlignment="Right" Background="#DBEAFE" CornerRadius="8" Padding="6,2">
                                    <TextBlock Text="{Binding Environment, FallbackValue='Development'}" Foreground="#2563EB" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Base de Datos" Foreground="#94A3B8" FontSize="12"/>
                                <TextBlock Text="{Binding DbType, FallbackValue='SQLITE'}" HorizontalAlignment="Right" Foreground="#1E293B" FontSize="12" FontWeight="Bold"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="Color" Foreground="#94A3B8" FontSize="12"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Ellipse Width="10" Height="10" Fill="{Binding BrandingColor, TargetNullValue=#3B82F6}" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding BrandingColor, TargetNullValue=#3B82F6}" Foreground="#1E293B" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    
                    <!-- Modules Box -->
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="15">
                        <Border.Resources>
                            <Style TargetType="Ellipse" x:Key="ModuleStatusIcon">
                                <Setter Property="Width" Value="12"/>
                                <Setter Property="Height" Value="12"/>
                                <Setter Property="Margin" Value="0,0,8,0"/>
                                <Setter Property="Fill" Value="#E2E8F0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel}, Path=Tag}" Value="True">
                                        <Setter Property="Fill" Value="#10B981"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                            <Style TargetType="TextBlock" x:Key="ModuleStatusText">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel}, Path=Tag}" Value="True">
                                        <Setter Property="Foreground" Value="#334155"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Resources>
                        <StackPanel>
                            <TextBlock Text="Módulos" Foreground="#64748B" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6" Tag="{Binding ModuleInventory}">
                                <Ellipse Style="{StaticResource ModuleStatusIcon}"/>
                                <TextBlock Text="Inventario" Style="{StaticResource ModuleStatusText}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6" Tag="{Binding ModuleReports}">
                                <Ellipse Style="{StaticResource ModuleStatusIcon}"/>
                                <TextBlock Text="Reportes" Style="{StaticResource ModuleStatusText}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6" Tag="{Binding ModuleCredit}">
                                <Ellipse Style="{StaticResource ModuleStatusIcon}"/>
                                <TextBlock Text="Crédito / Vales" Style="{StaticResource ModuleStatusText}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Tag="{Binding ModuleMultiStore}">
                                <Ellipse Style="{StaticResource ModuleStatusIcon}"/>
                                <TextBlock Text="Multi-Sucursal" Style="{StaticResource ModuleStatusText}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                </StackPanel>
            </Border>
        </Grid>
        
        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource TextPrimaryBrush}" BorderBrush="#1E293B" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="{Binding CurrentStepIndex, StringFormat='{}{0} / 7 completados'}" Foreground="#64748B" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="&lt; Anterior" Command="{Binding PreviousCommand}" Background="Transparent" Foreground="#94A3B8" FontWeight="SemiBold" Margin="0,0,20,0" Padding="0" Cursor="Hand" Visibility="{Binding CanGoPrevious, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <ProgressBar Value="{Binding CurrentStepIndex}" Maximum="6" Width="300" Height="4" Background="#1E293B" Foreground="#2563EB" BorderThickness="0" VerticalAlignment="Center"/>
                    <Button Content="Siguiente &gt;" Command="{Binding NextCommand}" Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="15,8" Margin="20,0,0,0" Cursor="Hand" Visibility="{Binding IsLastStep, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="Generar POS" Visibility="{Binding IsLastStep, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="15,8" Margin="20,0,0,0" Cursor="Hand" Click="Generate_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        
        <controls:LoadingOverlay x:Name="MainOverlay" Grid.RowSpan="3"/>
    </Grid>
</Window>
