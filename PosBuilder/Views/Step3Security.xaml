<UserControl x:Class="PosBuilder.Views.Step3Security"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="20">
        <TextBlock Text="Provision Key (Clave de Aprovisionamiento)" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <Grid Margin="0,0,0,5">
            <PasswordBox x:Name="ProvisionKeyBox" PasswordChanged="ProvisionKeyBox_PasswordChanged" Padding="8,8,30,8" />
            <TextBox x:Name="ProvisionKeyVisibleBox" Text="{Binding ProvisionKey, UpdateSourceTrigger=PropertyChanged}" Visibility="Collapsed" Padding="8,8,30,8" TextChanged="ProvisionKeyVisibleBox_TextChanged" />
            <ToggleButton x:Name="ToggleJwtVisibility" Content="👁" Width="25" Height="25" HorizontalAlignment="Right" Margin="0,0,5,0" Background="Transparent" BorderThickness="0" Click="ToggleJwtVisibility_Click" />
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Fuerza:" FontSize="12" Foreground="#64748B" Margin="0,0,5,0" VerticalAlignment="Center"/>
            <ProgressBar x:Name="StrengthMeter" Value="0" Maximum="100" Width="100" Height="8" Foreground="Red" BorderThickness="0" Background="#E2E8F0"/>
            <TextBlock x:Name="StrengthLabel" Text="Débil" FontSize="12" Foreground="Red" Margin="5,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
    </StackPanel>
</UserControl>
