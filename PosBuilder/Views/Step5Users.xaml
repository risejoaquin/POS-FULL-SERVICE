<UserControl x:Class="PosBuilder.Views.Step5Users"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:PosBuilder.Models" xmlns:local="clr-namespace:PosBuilder">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <!-- Administrador -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="ADMINISTRADOR DEL SISTEMA" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,15"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Usuario Admin" Foreground="#334155" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding AdminUser, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="13" BorderBrush="#CBD5E1" BorderThickness="1">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Contraseña Admin" Foreground="#334155" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                            <PasswordBox x:Name="AdminPassBox" PasswordChanged="AdminPassBox_PasswordChanged" Padding="10,8" FontSize="13" BorderBrush="#CBD5E1" BorderThickness="1">
                                <PasswordBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </PasswordBox.Resources>
                            </PasswordBox>
                            <TextBlock x:Name="AdminPassWarning" Text="Mínimo 6 caracteres recomendados" FontSize="11" Foreground="Orange" Visibility="Collapsed" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Empleados -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="0,0,0,15">
                        <TextBlock Text="EMPLEADOS" FontSize="11" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center"/>
                        <Button Content="+ Agregar Usuario" Command="{Binding AddUserCommand}" HorizontalAlignment="Right" Background="Transparent" Foreground="#2563EB" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="12"/>
                    </Grid>
                    
                    <!-- Main Employee (Required) -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Usuario" Foreground="#334155" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding EmployeeUser, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="13" BorderBrush="#CBD5E1" BorderThickness="1">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Contraseña" Foreground="#334155" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                            <PasswordBox x:Name="EmpPassBox" PasswordChanged="EmpPassBox_PasswordChanged" Padding="10,8" FontSize="13" BorderBrush="#CBD5E1" BorderThickness="1">
                                <PasswordBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </PasswordBox.Resources>
                            </PasswordBox>
                            <TextBlock x:Name="EmpPassWarning" Text="Mínimo 6 caracteres recomendados" FontSize="11" Foreground="Orange" Visibility="Collapsed" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Extra Employees -->
                    <ItemsControl ItemsSource="{Binding ExtraUsers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:UserModel}">
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0">
                                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="13" BorderBrush="#CBD5E1" BorderThickness="1">
                                            <TextBox.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </TextBox.Resources>
                                        </TextBox>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="2">
                                        <!-- Using TextBox for Extra User passwords to simplify bindings, since PasswordBox doesn't bind easily in WPF -->
                                        <PasswordBox local:PasswordBoxHelper.BindPassword="True" local:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="13" BorderBrush="#CBD5E1" BorderThickness="1">
                                            <PasswordBox.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </PasswordBox.Resources>
                                        </PasswordBox>
                                    </StackPanel>
                                    
                                    <Button Grid.Column="3" Command="{Binding DataContext.RemoveUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="5,0,0,0">
                                        <TextBlock Text="✕" Foreground="{StaticResource ErrorBrush}" FontSize="14" FontWeight="Bold"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
