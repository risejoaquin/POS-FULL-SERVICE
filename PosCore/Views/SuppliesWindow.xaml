<Window x:Class="PosCore.Views.SuppliesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventario de Insumos (Materia Prima)" MinHeight="700" SizeToContent="WidthAndHeight" MinWidth="1000"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Gestión de Insumos" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <Button Grid.Column="1" Content="+ Nuevo Insumo" MinWidth="150" Padding="15,0" Height="40" Background="{StaticResource PrimaryBrush}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnNewSupply_Click"/>
        </Grid>
        
        <!-- Supplies DataGrid -->
        <DataGrid x:Name="SuppliesDataGrid" Grid.Row="1" Margin="0,20,0,0" AutoGenerateColumns="False" CanUserAddRows="False" 
                  Background="White" MinRowHeight="45" ColumnHeaderHeight="40" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                  SelectionMode="Single" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Unidad (kg, L, pza)" Binding="{Binding UnitOfMeasure}" Width="150" IsReadOnly="True"/>
                <DataGridTextColumn Header="Costo ($)" Binding="{Binding Cost, StringFormat=C2}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="Stock Actual" Binding="{Binding Stock, StringFormat=N2}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="Stock Mínimo" Binding="{Binding MinStockThreshold, StringFormat=N2}" Width="120" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Acciones" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Editar" MinWidth="70" Padding="15,0" Height="30" Background="{StaticResource InfoBrush}" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnEditSupply_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        
        <!-- Footer -->
        <Button Grid.Row="2" Content="Cerrar" MinWidth="100" Padding="15,0" Height="40" HorizontalAlignment="Right" Margin="0,20,0,0" 
                Background="{StaticResource BorderBrush}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click"/>
    </Grid>
</Window>
