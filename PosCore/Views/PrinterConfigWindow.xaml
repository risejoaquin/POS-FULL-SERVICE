<Window x:Class="PosCore.Views.PrinterConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración de Impresora" MinHeight="300" SizeToContent="WidthAndHeight" MinWidth="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="25" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Seleccionar Impresora" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                
                <TextBlock Text="Impresora instalada:" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                <ComboBox x:Name="PrintersCombo" Height="40" Padding="5" FontSize="14" Margin="0,0,0,15" Background="{StaticResource BackgroundBrush}"/>
                
                <CheckBox x:Name="PrintLogoCheck" Content="Imprimir Logotipo de la Empresa" FontWeight="SemiBold" Margin="0,0,0,20"/>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" MinWidth="100" Padding="15,0" Height="40" Margin="0,0,10,0" Background="{StaticResource BorderBrush}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" BorderThickness="0" Click="BtnCancel_Click"/>
                    <Button Content="Guardar" MinWidth="120" Padding="15,0" Height="40" Background="{StaticResource SuccessBrush}" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnSave_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
