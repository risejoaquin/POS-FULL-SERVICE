<Window x:Class="PosCore.Views.SuspendedOrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Órdenes Suspendidas" MinHeight="400" SizeToContent="WidthAndHeight" MinWidth="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Background="{StaticResource SurfaceBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Órdenes en Espera" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,15"/>
        
        <ListView x:Name="OrdersList" Grid.Row="1" Margin="0,0,0,15" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Count, StringFormat='Orden con {0} artículos'}" FontSize="16" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Retomar" MinWidth="100" Padding="15,0" Height="30" Background="{StaticResource SuccessBrush}" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnResume_Click" Tag="{Binding}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        
        <Button Grid.Row="2" Content="Cerrar" MinWidth="100" Padding="15,0" Height="35" HorizontalAlignment="Right" Background="{StaticResource BorderBrush}" BorderThickness="0" Click="BtnClose_Click"/>
    </Grid>
</Window>
