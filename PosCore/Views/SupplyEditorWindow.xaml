<Window x:Class="PosCore.Views.SupplyEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar Insumo" MinHeight="450" SizeToContent="WidthAndHeight" MinWidth="400"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock x:Name="TitleText" Text="Nuevo Insumo" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20"/>
        
        <StackPanel Grid.Row="1">
            <TextBlock Text="Nombre del Insumo" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtName" Height="40" Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,0,15" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
            
            <TextBlock Text="Unidad de Medida (ej. kg, L, pza)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtUnit" Height="40" Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,0,15" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
            
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Costo Unitario ($)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtCost" Height="40" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Stock Actual" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtStock" Height="40" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                </StackPanel>
            </Grid>
            
            <TextBlock Text="Stock Mínimo" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtMinStock" Height="40" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Width="170" HorizontalAlignment="Left"/>
        </StackPanel>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancelar" MinWidth="90" Padding="15,0" Height="40" Background="{StaticResource BorderBrush}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" Click="BtnCancel_Click"/>
            <Button Content="Guardar" MinWidth="100" Padding="15,0" Height="40" Background="{StaticResource SuccessBrush}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
