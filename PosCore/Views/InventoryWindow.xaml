<Window x:Class="PosCore.Views.InventoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PosCore.Views"
        mc:Ignorable="d"
        Title="Control de Inventario - POS Express" MinHeight="650" SizeToContent="WidthAndHeight" MinWidth="1000" 
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Control de Inventario" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="📦 Gestionar Insumos" Command="{Binding OpenSuppliesCommand}" Height="35" MinWidth="150" Padding="15,0" Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand"/>
                        <Button Content="📥 Importar (CSV)" Command="{Binding ImportProductsCommand}" Height="35" MinWidth="130" Padding="15,0" Background="{StaticResource WarningBrush}" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand"/>
                        <Button Content="📤 Exportar (PDF/Excel)" Command="{Binding ExportProductsCommand}" Height="35" MinWidth="130" Padding="15,0" Background="#17A2B8" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </Grid>

        
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.5*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Lista de Productos -->
            <Grid Grid.Column="0" Margin="0,0,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                
                <WrapPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Width="150" Height="40" Margin="0,0,15,0" Padding="10,0" FontSize="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource SurfaceBrush}" VerticalContentAlignment="Center" ToolTip="Buscar"/>
                    <Button Content="➕ Agregar" Command="{Binding AddProductCommand}" MinWidth="100" Padding="15,0" Height="40" Background="{StaticResource SuccessBrush}" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand"/>
                    <Button Content="✏️ Editar" Command="{Binding EditProductCommand}" MinWidth="90" Padding="15,0" Height="40" Background="{StaticResource PrimaryBrush}" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand"/>
                    <Button Content="🗑️ Eliminar" Command="{Binding DeleteProductCommand}" MinWidth="90" Padding="15,0" Height="40" Background="{StaticResource ErrorBrush}" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand"/>
                    <Button Content="📋 Receta (BOM)" Command="{Binding ConfigureRecipeCommand}" MinWidth="130" Padding="15,0" Height="40" Background="{StaticResource InfoBrush}" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand"/>
                    <Button Content="⚙️ Modificadores" Command="{Binding ConfigureModifiersCommand}" MinWidth="140" Padding="15,0" Height="40" Background="{StaticResource PrimaryBrush}" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand"/>
                    <Button Content="🧪 Diagnóstico Drift" Command="{Binding ShowInventoryDriftDiagnosticsCommand}" MinWidth="160" Padding="15,0" Height="40" Background="#6F42C1" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" ToolTip="Ejecuta diagnóstico interno de drift. No corrige inventario."/>
                    <Button Content="📋 Copiar Drift" Command="{Binding CopyInventoryDriftDiagnosticsReportCommand}" MinWidth="130" Padding="15,0" Height="40" Background="#4B5563" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" ToolTip="Copia el reporte diagnóstico. No corrige inventario."/>
                    <Button Content="💾 Exportar Drift" Command="{Binding ExportInventoryDriftDiagnosticsReportCommand}" MinWidth="140" Padding="15,0" Height="40" Background="#0F766E" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" ToolTip="Exporta el reporte diagnóstico. No corrige inventario."/>
                    <Button Content="👁 Revisión Manual" Command="{Binding StartInventoryDriftManualReviewCommand}" MinWidth="150" Padding="15,0" Height="40" Background="#B45309" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" ToolTip="Prepara revisión manual de drift. No corrige inventario."/>
                    <Button Content="🧭 Diseño Reconciliación" Command="{Binding DesignControlledInventoryDriftReconciliationCommand}" MinWidth="190" Padding="15,0" Height="40" Background="#7C2D12" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" ToolTip="Diseña reconciliación manual controlada futura. No ejecuta ajustes de stock."/>
                    <Button Content="🔐 Validar Permiso" Command="{Binding PrepareInventoryDriftReconciliationPermissionGuardCommand}" MinWidth="160" Padding="15,0" Height="40" Background="#1D4ED8" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" ToolTip="Valida RBAC para reconciliación futura. No ejecuta ajustes de stock."/>
                    <Button Content="🧾 Preparar Auditoría" Command="{Binding PrepareInventoryDriftReconciliationAuditTrailCommand}" MinWidth="180" Padding="15,0" Height="40" Background="#6D28D9" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" ToolTip="Prepara audit trail de reconciliación futura; no ejecuta ajustes de stock."/>
                    <Button Content="🛡 Sync-Safe" Command="{Binding PrepareInventoryDriftReconciliationSyncSafetyGuardCommand}" MinWidth="160" Padding="15,0" Height="40" Background="#047857" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" ToolTip="Prepara guard sync-safe de reconciliación futura; no ejecuta ajustes de stock y no modifica sync."/>
                    <Button Content="🧩 Diseño Ejecución" Command="{Binding PrepareInventoryDriftControlledReconciliationExecutionDesignCommand}" MinWidth="180" Padding="15,0" Height="40" Background="#0F172A" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" ToolTip="Diseña ejecución controlada futura; no ejecuta reconciliación real, no modifica inventario y no modifica sync."/>
                    <Button Content="📘 Runbook Final" Command="{Binding PrepareInventoryDriftReconciliationFinalRunbookOperationalClosureCommand}" MinWidth="170" Padding="15,0" Height="40" Background="#334155" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" ToolTip="Prepara runbook operativo final; no ejecuta reconciliación real, no modifica inventario y no modifica sync."/>
                    <Button Content="🔄 Sync Reliability" Command="{Binding PreparePosOfflineSyncReliabilityBaselineCommand}" MinWidth="180" Padding="15,0" Height="40" Background="#0369A1" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" ToolTip="Prepara baseline de confiabilidad offline sync; no ejecuta sync real, no modifica inventario y no modifica checkout."/>
                    <Button Content="📦 Queue Diagnostics" Command="{Binding PreparePosOfflineSyncQueueDiagnosticsBaselineCommand}" MinWidth="190" Padding="15,0" Height="40" Background="#155E75" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" ToolTip="Prepara diagnóstico de cola offline sync; no ejecuta sync real, no escribe cola, no modifica inventario y no modifica checkout."/>
                    <Button Content="🔑 Idempotency Keys" Command="{Binding PreparePosOfflineSyncIdempotencyKeyStrategyBaselineCommand}" MinWidth="190" Padding="15,0" Height="40" Background="#7C2D12" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" ToolTip="Prepara estrategia de idempotencia offline sync; no ejecuta sync real, no escribe cola, no modifica inventario y no modifica checkout."/>
                    <Button Content="⏱ Retry Backoff" Command="{Binding PreparePosOfflineSyncRetryBackoffPolicyBaselineCommand}" MinWidth="180" Padding="15,0" Height="40" Background="#9333EA" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" ToolTip="Prepara política retry/backoff offline sync; no ejecuta sync real, no escribe cola, no modifica inventario y no modifica checkout."/>
                    <Button Content="⚠ Conflict Detection" Command="{Binding PreparePosOfflineSyncConflictDetectionStrategyBaselineCommand}" MinWidth="190" Padding="15,0" Height="40" Background="#BE123C" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" ToolTip="Prepara estrategia de detección de conflictos offline sync; no ejecuta sync real, no escribe cola, no resuelve conflictos, no modifica inventario y no modifica checkout."/>
                    <Button Content="✅ Sync Checkpoint" Command="{Binding PreparePosOfflineSyncCheckpointLastSuccessStateBaselineCommand}" MinWidth="190" Padding="15,0" Height="40" Background="#0E7490" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" ToolTip="Prepara checkpoint y last success state offline sync; no ejecuta sync real, no escribe cola, no avanza checkpoints, no modifica inventario y no modifica checkout."/>
                
                    <Button Content="🧷 Sync Ownership" Command="{Binding PreparePosOfflineSyncTenantDeviceBoundarySyncOwnershipBaselineCommand}" MinWidth="190" Padding="15,0" Height="40" Background="#B45309" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" ToolTip="Prepara tenant/device boundary y sync ownership offline sync; no ejecuta sync real, no escribe cola, no reclama ownership, no avanza checkpoints, no modifica inventario y no modifica checkout."/>
                    <Button Content="🔎 Sync Observability" Command="{Binding PreparePosOfflineSyncObservabilityCorrelationBaselineCommand}" MinWidth="210" Padding="15,0" Height="40" Background="#0F766E" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" ToolTip="Prepara observability/correlation offline sync: correlation id, tenant id, device id, sync operation id, queue item id, idempotency key, retry/backoff, checkpoint state, last success state y sensitive data redaction; no ejecuta sync real, no escribe cola, no emite telemetría, no avanza checkpoints, no modifica inventario y no modifica checkout."/>
                    <Button Content="🧰 Manual Recovery" Command="{Binding PreparePosOfflineSyncManualRecoveryRunbookBaselineCommand}" MinWidth="190" Padding="15,0" Height="40" Background="#BE123C" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" ToolTip="Prepara manual recovery runbook offline sync: entry criteria, operator triage, queue snapshot, checkpoint freeze, correlation id evidence, tenant id, device id, idempotency key, retry/backoff, conflict detection, dead-letter review y approval requirement; no ejecuta sync real, no escribe cola, no ejecuta recuperación manual, no avanza checkpoints, no modifica inventario y no modifica checkout."/>
                    <Button Content="🏁 Sync Closure" Command="{Binding PreparePosOfflineSyncOperationalClosureBaselineCommand}" MinWidth="180" Padding="15,0" Height="40" Background="#334155" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" ToolTip="Prepara operational closure offline sync: final readiness checklist, evidence archive, queue health closure, checkpoint closure, production enablement gate, rollback escalation y operator sign-off; no ejecuta sync real, no escribe cola, no ejecuta cierre operacional, no avanza checkpoints, no modifica inventario y no modifica checkout."/>
                    <Button Content="🚦 Sync Gate" Command="{Binding PreparePosProductionSyncExecutionGateSafeEnablementBaselineCommand}" MinWidth="180" Padding="15,0" Height="40" Background="#0F766E" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" ToolTip="Prepara production sync execution gate y safe enablement: reliability closure, queue health, idempotency, checkpoints, observability, manual recovery, rollback plan, feature flag, canary enablement y production approval; no ejecuta sync real, no escribe cola, no habilita sync, no avanza checkpoints, no modifica inventario y no modifica checkout."/>
                    <Button Content="🛑 Sync Kill Switch" Command="{Binding PreparePosProductionSyncFeatureFlagKillSwitchBaselineCommand}" MinWidth="200" Padding="15,0" Height="40" Background="#991B1B" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" ToolTip="Prepara production sync feature flag y kill switch: default disabled state, tenant scoped flag, device scoped flag, kill switch, safe disable behavior, rollback trigger, queue pause, checkpoint freeze, idempotency preservation y audit logging; no ejecuta sync real, no escribe cola, no habilita sync, no alterna runtime flags, no avanza checkpoints, no modifica inventario y no modifica checkout."/>
                    <Button Content="Sync Canary" Command="{Binding PreparePosProductionSyncCanaryRolloutBaselineCommand}" MinWidth="190" Padding="15,0" Height="40" Background="#047857" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" ToolTip="Prepara production sync canary rollout: canary cohort selection, tenant canary scope, device canary scope, percentage cap, monitoring window, failure thresholds, rollback criteria, kill switch integration y feature flag promotion gate; no ejecuta sync real, no escribe cola, no habilita sync, no alterna runtime flags, no avanza checkpoints, no modifica inventario y no modifica checkout."/>
                    <Button Content="Sync Processor" Command="{Binding PreparePosProductionSyncQueueProcessorExecutionBaselineCommand}" MinWidth="200" Padding="15,0" Height="40" Background="#1D4ED8" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" ToolTip="Prepara production sync queue processor execution: processor ownership, feature flag prerequisite, kill switch prerequisite, canary prerequisite, tenant/device validation, queue claim strategy, idempotency enforcement, checkpoint commit boundary y failure handoff; no ejecuta sync real, no escribe cola, no reclama queue items, no avanza checkpoints, no modifica inventario y no modifica checkout."/>
                    <Button Content="Ack Checkpoint" Command="{Binding PreparePosProductionSyncServerAcknowledgementCheckpointCommitBaselineCommand}" MinWidth="210" Padding="15,0" Height="40" Background="#7C3AED" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" ToolTip="Prepara production sync server acknowledgement checkpoint commit: acknowledgement contract, status validation, durable acknowledgement evidence, correlation/idempotency matching, tenant/device matching, queue item id matching, checkpoint commit boundary y failure handoff; no ejecuta sync real, no escribe cola, no envía acknowledgements, no confirma checkpoints, no modifica inventario y no modifica checkout."/>
                    <Button Content="Conflict Gate" Command="{Binding PreparePosProductionSyncConflictResolutionExecutionGateBaselineCommand}" MinWidth="200" Padding="15,0" Height="40" Background="#B45309" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" ToolTip="Prepara production sync conflict resolution execution gate: conflict classification, server acknowledgement prerequisite, checkpoint prerequisite, manual approval, tenant/device validation, idempotency evidence, rollback plan y audit log requirement; no ejecuta sync real, no resuelve conflictos, no escribe cola, no confirma checkpoints, no modifica inventario y no modifica checkout."/>
                    <Button Content="Dead-Letter" Command="{Binding PreparePosProductionSyncDeadLetterManualInterventionBaselineCommand}" MinWidth="200" Padding="15,0" Height="40" Background="#7F1D1D" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" ToolTip="Prepara production sync dead-letter queue manual intervention: dead-letter queue contract, terminal failure criteria, manual intervention workflow, evidence package, tenant/device scope, idempotency evidence, checkpoint freeze y audit log requirement; no ejecuta sync real, no escribe cola, no mueve items a dead-letter, no ejecuta intervención manual, no confirma checkpoints, no modifica inventario y no modifica checkout."/>
                    <Button Content="Runtime Metrics" Command="{Binding PreparePosProductionSyncObservabilityRuntimeMetricsBaselineCommand}" MinWidth="210" Padding="15,0" Height="40" Background="#0F766E" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" ToolTip="Prepara production sync observability runtime metrics: runtime metrics contract, queue depth, processing latency, acknowledgement latency, checkpoint lag, retry rate, dead-letter rate, conflict rate, error rate, throughput, tenant/device dimensions, correlation id trace, redaction, alert thresholds y operator dashboard; no ejecuta sync real, no escribe cola, no emite runtime metrics, no cambia alerting configuration, no confirma checkpoints, no modifica inventario y no modifica checkout."/>
                    <Button Content="📘 Support Runbook" Command="{Binding PreparePosProductionSyncOperationalRunbookSupportHandoffBaselineCommand}" MinWidth="210" Padding="15,0" Height="40" Background="#1E3A8A" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" ToolTip="Prepara production sync operational runbook y support handoff: operational runbook, support handoff workflow, incident severity, first response checklist, escalation matrix, evidence package, queue snapshot, runtime metrics, correlation id, tenant/device, idempotency key, checkpoint state, feature flag, kill switch, dead-letter state, operator communication y closure criteria; no ejecuta sync real, no escribe cola, no ejecuta support handoff, no cambia runtime operations, no confirma checkpoints, no modifica inventario y no modifica checkout."/>
                    <Button Content="✅ Sync Readiness" Command="{Binding PreparePosProductionSyncFinalEnablementReadinessClosureBaselineCommand}" MinWidth="210" Padding="15,0" Height="40" Background="#166534" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" ToolTip="Prepara production sync final enablement readiness closure: all prior closures, verification evidence, test pass evidence, build pass evidence, feature flag readiness, kill switch readiness, canary readiness, queue processor readiness, server acknowledgement readiness, conflict resolution readiness, dead-letter readiness, observability readiness, runbook support handoff readiness, rollback readiness, production approval y operator sign-off; no ejecuta sync real, no habilita sync, no escribe cola, no alterna runtime flags, no avanza checkpoints, no ejecuta support handoff, no modifica inventario y no modifica checkout."/>
