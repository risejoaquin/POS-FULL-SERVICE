<Window x:Class="PosCore.Views.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OasisDrinks - Cobrar Venta" Height="650" Width="850"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#0d4722" WindowStyle="None">
    <Window.Resources>
        <Style x:Key="NumpadBtn" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#F3F4F6">
        <!-- Close Button Top Right -->
        <Button Content="✕" Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="15" Background="Transparent" Foreground="#9CA3AF" FontSize="20" BorderThickness="0" Click="BtnCancel_Click" Cursor="Hand"/>
        
        <Grid Margin="40,50,40,40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left: Payment Methods & Total -->
            <StackPanel Grid.Column="0" Margin="0,0,30,0">
                <TextBlock Text="Total a Cobrar:" FontSize="18" Foreground="#6B7280" FontWeight="SemiBold"/>
                <TextBlock x:Name="TotalText" Text="$113.68" FontSize="48" FontWeight="Black" Foreground="#111827" Margin="0,0,0,30"/>
                
                <TextBlock Text="MÉTODO DE PAGO" FontSize="12" Foreground="#9CA3AF" FontWeight="Bold" LetterSpacing="1" Margin="0,0,0,15"/>
                
                <Button x:Name="BtnEfectivo" Content="Efectivo" Background="#10B981" Foreground="White" Height="60" BorderThickness="0" Margin="0,0,0,10" FontWeight="Bold" FontSize="18" Click="BtnPayEfectivo_Click">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                </Button>
                <Button x:Name="BtnTarjeta" Content="Tarjeta Bancaria" Background="White" Foreground="#4B5563" BorderBrush="#E5E7EB" BorderThickness="1" Height="60" Margin="0,0,0,10" FontWeight="Bold" FontSize="16" Click="BtnPayTarjeta_Click">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                </Button>
                <Button x:Name="BtnTransferencia" Content="Transferencia" Background="White" Foreground="#4B5563" BorderBrush="#E5E7EB" BorderThickness="1" Height="60" Margin="0,0,0,10" FontWeight="Bold" FontSize="16" Click="BtnPayTransferencia_Click">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                </Button>
                <Button x:Name="BtnVale" Content="Vale / Cortesia" Background="White" Foreground="#4B5563" BorderBrush="#E5E7EB" BorderThickness="1" Height="60" Margin="0,0,0,10" FontWeight="Bold" FontSize="16" Click="BtnPayVale_Click">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                </Button>
            </StackPanel>
            
            <!-- Right: Input & Numpad -->
            <Border Grid.Column="1" Background="White" CornerRadius="20" Padding="30">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5" Opacity="0.05"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="CANTIDAD RECIBIDA" FontSize="12" Foreground="#9CA3AF" FontWeight="Bold" LetterSpacing="1" HorizontalAlignment="Center"/>
                    <TextBox x:Name="InputAmountBox" Text="0.00" FontSize="42" FontWeight="Bold" Foreground="#0d4722" BorderThickness="0" Background="Transparent" HorizontalAlignment="Center" Margin="0,10,0,20"/>
                    
                    <Grid Height="250">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button Grid.Row="0" Grid.Column="0" Content="1" Style="{StaticResource NumpadBtn}" Click="BtnNumpad_Click"/>
                        <Button Grid.Row="0" Grid.Column="1" Content="2" Style="{StaticResource NumpadBtn}" Click="BtnNumpad_Click"/>
                        <Button Grid.Row="0" Grid.Column="2" Content="3" Style="{StaticResource NumpadBtn}" Click="BtnNumpad_Click"/>
                        
                        <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{StaticResource NumpadBtn}" Click="BtnNumpad_Click"/>
                        <Button Grid.Row="1" Grid.Column="1" Content="5" Style="{StaticResource NumpadBtn}" Click="BtnNumpad_Click"/>
                        <Button Grid.Row="1" Grid.Column="2" Content="6" Style="{StaticResource NumpadBtn}" Click="BtnNumpad_Click"/>
                        
                        <Button Grid.Row="2" Grid.Column="0" Content="7" Style="{StaticResource NumpadBtn}" Click="BtnNumpad_Click"/>
                        <Button Grid.Row="2" Grid.Column="1" Content="8" Style="{StaticResource NumpadBtn}" Click="BtnNumpad_Click"/>
                        <Button Grid.Row="2" Grid.Column="2" Content="9" Style="{StaticResource NumpadBtn}" Click="BtnNumpad_Click"/>
                        
                        <Button Grid.Row="3" Grid.Column="0" Content="." Style="{StaticResource NumpadBtn}" Click="BtnNumpad_Click"/>
                        <Button Grid.Row="3" Grid.Column="1" Content="0" Style="{StaticResource NumpadBtn}" Click="BtnNumpad_Click"/>
                        <Button Grid.Row="3" Grid.Column="2" Content="⌫" Style="{StaticResource NumpadBtn}" Foreground="#EF4444" Click="BtnNumpadDel_Click"/>
                    </Grid>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                        <Button x:Name="BtnExact" Content="$113.68" Background="#F0FDF4" Foreground="#10B981" BorderThickness="0" Padding="15,10" Margin="5" FontWeight="Bold" FontSize="14" Click="BtnQuickAmount_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        <Button Content="$150.00" Background="#F3F4F6" Foreground="#4B5563" BorderThickness="0" Padding="15,10" Margin="5" FontWeight="Bold" FontSize="14" Click="BtnQuickAmount_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        <Button Content="$200.00" Background="#F3F4F6" Foreground="#4B5563" BorderThickness="0" Padding="15,10" Margin="5" FontWeight="Bold" FontSize="14" Click="BtnQuickAmount_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        <Button Content="$500.00" Background="#F3F4F6" Foreground="#4B5563" BorderThickness="0" Padding="15,10" Margin="5" FontWeight="Bold" FontSize="14" Click="BtnQuickAmount_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                    
                    <Button x:Name="BtnComplete" Content="Validar Pago" Background="#3B82F6" Foreground="White" Height="55" Margin="0,15,0,0" FontWeight="Bold" FontSize="18" BorderThickness="0" Click="BtnComplete_Click">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
