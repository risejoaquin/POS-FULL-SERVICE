<Window x:Class="PosCore.Views.ModifierSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seleccionar Modificadores" MinHeight="650" SizeToContent="WidthAndHeight" MinWidth="550"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Background="{StaticResource SurfaceBrush}" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="ProductNameText" Text="Producto" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock x:Name="ProductPriceText" Text="$0.00" FontSize="18" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- Modifiers List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ModifiersPanel" Margin="10">
            </StackPanel>
        </ScrollViewer>
        
        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Total Calculado:" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="TotalPriceText" Text="$0.00" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Cancelar" MinWidth="120" Padding="15,0" Height="45" Background="{StaticResource BorderBrush}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" Click="BtnCancel_Click"/>
                <Button Grid.Column="2" Content="Agregar a la Orden" MinWidth="180" Padding="15,0" Height="45" Background="{StaticResource PrimaryBrush}" Foreground="White" FontSize="16" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnAdd_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
