<Window x:Class="PosCore.Views.UsersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Gestión de Usuarios" MinHeight="500" SizeToContent="WidthAndHeight" MinWidth="700" WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Gestión de Usuarios / Cajeros" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20"/>
        
        <!-- Add New User Form -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Nombre de Usuario" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" Padding="5" FontSize="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Contraseña (ej. 1234)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="NewPinBox" PasswordChanged="NewPinBox_PasswordChanged" Padding="5" FontSize="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="Rol" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding NewRole}" Padding="5" FontSize="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                </StackPanel>

                <Button Grid.Column="3" Content="Guardar" Command="{Binding AddUserCommand}" 
                        Background="{StaticResource SuccessBrush}" Foreground="White" FontWeight="Bold" Padding="15,0" BorderThickness="0" Cursor="Hand" VerticalAlignment="Bottom" Height="30"/>
            </Grid>
        </Border>

        <!-- Users List -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Users}" AutoGenerateColumns="False" IsReadOnly="True" 
                  Background="{StaticResource SurfaceBrush}" MinRowHeight="40" AlternatingRowBackground="{StaticResource BackgroundBrush}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrush}" HeadersVisibility="Column" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Usuario" Binding="{Binding Username}" Width="2*"/>
                <DataGridTextColumn Header="Rol" Binding="{Binding Role}" Width="*"/>
                <DataGridTemplateColumn Header="Contraseña" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="••••••••" VerticalAlignment="Center" Margin="5,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <DataGridTemplateColumn Header="Acciones" Width="260">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <WrapPanel>
                                <Button Content="Editar" Command="{Binding DataContext.EditUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                        Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0" Cursor="Hand" Padding="10,5" Margin="5"/>
                                <Button Content="Reset Contraseña" Command="{Binding DataContext.ResetPinCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                        Background="{StaticResource WarningBrush}" Foreground="White" BorderThickness="0" Cursor="Hand" Padding="10,5" Margin="5"/>
                                <Button Content="Eliminar" Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                        Background="{StaticResource ErrorBrush}" Foreground="White" BorderThickness="0" Cursor="Hand" Padding="10,5" Margin="5"/>
                            </WrapPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
