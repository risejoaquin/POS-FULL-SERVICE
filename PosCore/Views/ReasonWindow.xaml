<Window x:Class="PosCore.Views.ReasonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Motivo de Anulación - POS Express" Height="380" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="25" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#020617" BlurRadius="16" ShadowDepth="4" Opacity="0.06" Direction="270" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Text="Motivo de Anulación" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                <TextBlock Text="Seleccione o ingrese el motivo para esta acción." FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,25"/>
                
                <ComboBox x:Name="ReasonCombo" Grid.Row="1" FontSize="16" Height="45" Margin="0,0,0,15" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" Padding="10,0">
                    <ComboBoxItem Content="Cliente se arrepintió" IsSelected="True"/>
                    <ComboBoxItem Content="Error de cobro"/>
                    <ComboBoxItem Content="Producto en mal estado / Merma"/>
                    <ComboBoxItem Content="Otro"/>
                </ComboBox>
                
                <TextBox x:Name="OtherReasonBox" Grid.Row="2" FontSize="14" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,20" Padding="10" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Visibility="Collapsed"/>
                
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Content="Cancelar" Width="120" Height="45" Margin="0,0,15,0" Background="{StaticResource BorderBrush}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" BorderThickness="0" Click="BtnCancel_Click" Cursor="Hand"/>
                    <Button Content="Confirmar" Width="140" Height="45" Background="{StaticResource ErrorBrush}" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Click="BtnConfirm_Click" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
