<Window x:Class="PosCore.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PosCore.Views"
        xmlns:vm="clr-namespace:PosCore.ViewModels"
        xmlns:controls="clr-namespace:PosCore.Views.Controls"
        mc:Ignorable="d"
        Title="{Binding Settings.WhiteLabel.CompanyName, StringFormat='{}POS - {0}'}" Height="768" Width="1024" WindowState="Maximized" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F12" Command="{Binding CheckoutCommand}" />
        <KeyBinding Key="F4" Command="{Binding OpenShiftCommand}" />
        <KeyBinding Key="F2" Command="{Binding SuspendOrderCommand}" />
        <KeyBinding Key="F1" Command="{Binding FocusSearchCommand}" />
        <KeyBinding Key="F3" Command="{Binding ResumeOrderCommand}" />
        <KeyBinding Key="F5" Command="{Binding OpenReturnsCommand}" />
        <KeyBinding Key="F6" Command="{Binding OpenReportsCommand}" />
        <KeyBinding Key="F7" Command="{Binding OpenUsersCommand}" />
        <KeyBinding Key="F8" Command="{Binding OpenInventoryCommand}" />
    </Window.InputBindings>
    
    <Grid Background="#F3F4F6">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        
        <!-- Top Header (Dark Green) -->
        <Border Grid.Row="0" Background="#0d4722" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,30,0">
                    <Border Background="#10B981" Width="30" Height="30" CornerRadius="8" Margin="0,0,10,0">
                        <TextBlock Text="O" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="OasisDrinks" Foreground="White" FontWeight="Bold" FontSize="20" VerticalAlignment="Center"/>
                    <TextBlock Text="POS" Foreground="#A7F3D0" FontSize="14" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                
                <!-- Search -->
                <Border Grid.Column="1" Background="#115b30" CornerRadius="8" Margin="0,10" Padding="15,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" Foreground="#A7F3D0" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="14"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="Transparent" BorderThickness="0" Foreground="White" FontSize="14" 
                                 VerticalContentAlignment="Center" VerticalAlignment="Stretch"
                                 PreviewKeyDown="SearchBox_PreviewKeyDown" GotFocus="SearchBox_GotFocus"/>
                        <TextBlock Grid.Column="1" Text="Buscar producto o código... (F1)" Foreground="#619d7d" VerticalAlignment="Center" IsHitTestVisible="False" Margin="2,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
                
                <!-- Right Side (Clock & User) -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                        <TextBlock Text="05:29 p.m." Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Right"/>
                        <TextBlock Text="mar 4 de ago" Foreground="#A7F3D0" FontSize="11" HorizontalAlignment="Right"/>
                    </StackPanel>
                    
                    
                    <Border BorderBrush="#115b30" BorderThickness="1" CornerRadius="20" Padding="5,5,15,5" Background="#115b30">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="15" Background="#0d4722" Margin="0,0,10,0">
                                <TextBlock Text="👤" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentUsername}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                <TextBlock Text="{Binding CurrentUserRole}" Foreground="#A7F3D0" FontWeight="SemiBold" FontSize="10"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                            <TextBlock Text="{Binding CurrentUser.Role, TargetNullValue='Administrador'}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="14"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Columna 0: Búsqueda y Productos -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Margin="5" Padding="5">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.05"/>
                </Border.Effect>
                <controls:ProductsPanelControl />
            </Border>
            
            <!-- Columna 1: Carrito de Compra -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Margin="5" Padding="5">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.05"/>
                </Border.Effect>
                <controls:CartPanelControl />
            </Border>
            
            <!-- Columna 2: Acciones (Cobro y Atajos) -->
            <Border Grid.Column="2" Background="White" CornerRadius="12" Margin="5" Padding="5">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.05"/>
                </Border.Effect>
                <controls:ActionPanelControl />
            </Border>
        </Grid>
        
        <!-- Bottom Footer (Replaces StatusBarControl) -->
        <Border Grid.Row="2" Background="#0d4722" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Bottom Menu -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Inventario" Command="{Binding OpenInventoryCommand}" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" Foreground="White" Background="Transparent" BorderThickness="0" Margin="0,0,15,0" FontWeight="SemiBold" FontSize="12" Cursor="Hand"/>
                    <Button Content="Usuarios" Command="{Binding OpenUsersCommand}" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" Foreground="White" Background="Transparent" BorderThickness="0" Margin="0,0,15,0" FontWeight="SemiBold" FontSize="12" Cursor="Hand"/>
                    <Button Content="Reportes" Command="{Binding OpenReportsCommand}" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" Foreground="White" Background="Transparent" BorderThickness="0" Margin="0,0,15,0" FontWeight="SemiBold" FontSize="12" Cursor="Hand"/>
                    <Button Content="Devoluciones" Command="{Binding OpenReturnsCommand}" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" Foreground="White" Background="Transparent" BorderThickness="0" Margin="0,0,15,0" FontWeight="SemiBold" FontSize="12" Cursor="Hand"/>
                    <Button Content="Config" Command="{Binding OpenSettingsCommand}" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" Foreground="White" Background="Transparent" BorderThickness="0" Margin="0,0,15,0" FontWeight="SemiBold" FontSize="12" Cursor="Hand"/>
                </StackPanel>

                
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0"/>
                    <TextBlock Text="Sincronizado" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="hace 2 min" Foreground="#A7F3D0" FontSize="12" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <controls:LoadingOverlay x:Name="MainOverlay" Grid.RowSpan="3"/>
    </Grid>
</Window>
