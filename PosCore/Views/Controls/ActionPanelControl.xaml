<UserControl x:Class="PosCore.Views.Controls.ActionPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="300"
             Background="{StaticResource SurfaceBrush}">
    <UserControl.Resources>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Acciones Principales -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <Button Command="{Binding OpenShiftCommand}" ToolTip="Abrir o cerrar el turno actual, ingresando los montos correspondientes en caja." Background="{StaticResource SuccessBrush}" Foreground="White" Margin="0,0,0,10" MinHeight="40" BorderThickness="0" FontWeight="Bold" FontSize="14">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                <TextBlock Text="Apertura/Corte Caja (F4)" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
            </Button>
            <Button Command="{Binding SuspendOrderCommand}" ToolTip="Pone la orden actual en espera para poder atender a otro cliente." Background="{StaticResource WarningBrush}" Foreground="White" Margin="0,0,0,10" MinHeight="40" BorderThickness="0" FontWeight="Bold" FontSize="14">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                <TextBlock Text="Suspender Orden (F2)" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
            </Button>
            <Button Command="{Binding ResumeOrderCommand}" ToolTip="Recupera una orden previamente suspendida." Background="{StaticResource PrimaryBrush}" Foreground="White" MinHeight="40" BorderThickness="0" FontWeight="Bold" FontSize="14">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                <TextBlock Text="Recuperar Orden (F3)" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
            </Button>
        </StackPanel>

        <!-- Shortcuts 3x3 -->
        
        <!-- Espaciador -->
        <Border Grid.Row="2"/>

        <Button Grid.Row="2" VerticalAlignment="Bottom" Command="{Binding CancelSaleCommand}" ToolTip="Cancela la venta actual y vacía el carrito." Background="#FEE2E2" Foreground="#DC2626" Margin="0,0,0,10" MinHeight="40" BorderThickness="0" FontWeight="Bold" FontSize="14">
            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
            <TextBlock Text="Cancelar Venta (F11)" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
        </Button>

        <!-- Cobrar -->
        <Button Grid.Row="3" Command="{Binding CheckoutCommand}" ToolTip="Finaliza la orden actual, procesa el pago y emite el recibo." Background="{StaticResource PrimaryBrush}" Foreground="White" MinHeight="80" BorderThickness="0" Cursor="Hand">
            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="COBRAR" FontWeight="Bold" FontSize="24" Margin="0,0,15,0" VerticalAlignment="Center"/>
                <TextBlock Text="[F12]" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </WrapPanel>
        </Button>
    </Grid>
</UserControl>
