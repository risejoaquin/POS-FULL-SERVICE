<UserControl x:Class="PosCore.Views.Controls.ProductsPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="300"
             Background="{StaticResource SurfaceBrush}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Search Box -->
        <Border Grid.Row="0" BorderBrush="#2D5F2E" BorderThickness="2" CornerRadius="8" Margin="0,0,0,10" Background="{StaticResource SurfaceBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="🔍" VerticalAlignment="Center" Margin="10,0" FontSize="18"/>
                <TextBox x:Name="SearchBox" Grid.Column="1" 
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="16" Padding="5" BorderThickness="0" Background="Transparent"
                         ToolTip="Buscar producto o escanear código"
                         PreviewKeyDown="SearchBox_PreviewKeyDown" GotFocus="SearchBox_GotFocus"/>
                <TextBlock Grid.Column="1" Text="[F1] Escáner Activo..." Foreground="Gray" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False" FontSize="14" FontStyle="Italic">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="2" Text="⚡" Foreground="#2D5F2E" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Listo para escanear" FontSize="16"/>
            </Grid>
        </Border>

        <!-- Categories Grid 4x4 -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Categorías" FontWeight="Bold" FontSize="14" Foreground="#2D5F2E" Margin="0,0,0,5"/>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Categories}" MinHeight="160">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.FilterByCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Background="#D4145A" Foreground="White" Margin="2" BorderThickness="0" FontWeight="Bold" Cursor="Hand" MinHeight="40" Padding="10,0">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Products List -->
        <ListView Grid.Row="2" ItemsSource="{Binding FilteredProducts}" BorderThickness="0" Background="Transparent"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="5" Padding="10" Background="{StaticResource SurfaceBrush}" Width="260">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Image -->
                            <Border Grid.Column="0" Width="50" Height="50" CornerRadius="8" Background="{StaticResource BackgroundBrush}" Margin="0,0,10,0" ClipToBounds="True">
                                <Grid>
                                    <TextBlock Text="🍔" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image Source="{Binding ImagePath}" Stretch="UniformToFill" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding Price, StringFormat=C}" Foreground="#2D5F2E" FontWeight="Bold" FontSize="14" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding Barcode, StringFormat='Cod: {0}'}" FontSize="11" Foreground="Gray"/>
                            </StackPanel>

                            <Button Grid.Column="2" Content="Añadir +" 
                                    Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Height="40" Margin="10,0,0,0" 
                                    Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="14" FontWeight="Bold">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
